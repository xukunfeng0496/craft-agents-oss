{
  "name": "@craft-agent/session-share-server",
  "version": "0.10.301",
  "license": "Apache-2.0",
  "description": "CVTE intranet backend for Work Agents session sharing (the /s/api store behind apps/viewer). Self-hosted replacement for the public agents.craft.do store (D11).",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "session-share-server": "./dist/index.js"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir=dist --target=bun",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.3"
  }
}
