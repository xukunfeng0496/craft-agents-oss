---
interface Asset {
  name: string;
  downloadUrl: string;
  size: number;
}

interface Props {
  version?: string;
  assets?: Asset[];
}

const { version = '0.5.3', assets = [] } = Astro.props;

function getUrl(pattern: string, fallback: string): string {
  const asset = assets.find(a => a.name.toLowerCase().includes(pattern));
  return asset?.downloadUrl || fallback;
}

const base = `https://github.com/xukunfeng0496/work-agents/releases/download/v${version}`;
const downloads = [
  { platform: 'mac-arm', label: 'Download for Mac', sublabel: 'Apple Silicon', icon: 'apple', url: getUrl('osx-arm64', `${base}/Work-Agent-${version}-osx-arm64.dmg`) },
  { platform: 'mac-intel', label: 'Download for Mac', sublabel: 'Intel', icon: 'apple', url: getUrl('osx-x64', `${base}/Work-Agent-${version}-osx-x64.dmg`) },
  { platform: 'windows', label: 'Download for Windows', sublabel: '', icon: 'windows', url: getUrl('windows-x64', `${base}/Work-Agent-${version}-windows-x64.exe`) },
  { platform: 'linux', label: 'Download for Linux', sublabel: 'AppImage', icon: 'linux', url: getUrl('linux-x64', `${base}/Work-Agent-${version}-linux-x64.AppImage`) },
];
---

<div class="download-button relative inline-block">
  <button
    class="download-main-btn btn-primary text-lg"
    aria-haspopup="listbox"
    aria-expanded="false"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
    </svg>
    <span class="download-label">Download</span>
    <svg class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
    </svg>
  </button>

  <div
    class="download-dropdown"
    role="listbox"
    style="display:none; position:absolute; top:calc(100% + 8px); left:0; min-width:240px; background:white; border-radius:8px; box-shadow:0 0 0 1px rgba(38,36,42,0.06),0 4px 6px -1px rgba(0,0,0,0.08),0 10px 20px -5px rgba(0,0,0,0.08); padding:6px 0; z-index:50;"
  >
    {downloads.map((d) => (
      <a
        href={d.url}
        class="dropdown-item"
        role="option"
        data-platform={d.platform}
        style="display:flex; align-items:center; gap:12px; padding:10px 16px; text-decoration:none; color:inherit;"
      >
        {d.icon === 'apple' && (
          <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
          </svg>
        )}
        {d.icon === 'windows' && (
          <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M3 12V6.75l6-1.32v6.48L3 12zm17-9v8.75l-10 .15V5.21L20 3zM3 13l6 .09v6.81l-6-1.15V13zm17 .25V22l-10-1.91V13.1l10 .15z"/>
          </svg>
        )}
        {d.icon === 'linux' && (
          <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.504 0c-.155 0-.315.008-.48.021-4.226.333-3.105 4.807-3.17 6.298-.076 1.092-.3 1.953-1.05 3.02-.885 1.051-2.127 2.75-2.716 4.521-.278.832-.41 1.684-.287 2.489a.424.424 0 00-.11.135c-.26.268-.45.6-.663.839-.199.199-.485.267-.797.4-.313.136-.658.269-.864.68-.09.189-.136.394-.132.602 0 .199.027.4.055.536.058.399.116.728.04.97-.249.68-.28 1.145-.106 1.484.174.334.535.47.94.601.81.2 1.91.135 2.774.6.926.466 1.866.67 2.616.47.526-.116.97-.464 1.208-.946.587-.003 1.23-.269 2.26-.334.699-.058 1.574.267 2.577.2.025.134.063.198.114.333l.003.003c.391.778 1.113 1.132 1.884 1.071.771-.06 1.592-.536 2.257-1.306.631-.765 1.683-1.084 2.378-1.503.348-.199.629-.469.649-.853.023-.4-.2-.811-.714-1.376v-.097l-.003-.003c-.17-.2-.25-.535-.338-.926-.085-.401-.182-.786-.492-1.046h-.003c-.059-.054-.123-.067-.188-.135a.357.357 0 00-.19-.064c.431-1.278.264-2.55-.173-3.694-.533-1.41-1.465-2.638-2.175-3.483-.796-1.005-1.576-1.957-1.56-3.368.026-2.152.236-6.133-3.544-6.139z"/>
          </svg>
        )}
        <div>
          <div style="font-weight:500;">{d.label}</div>
          {d.sublabel && <div style="font-size:0.8rem;color:#6b7280;">{d.sublabel}</div>}
        </div>
      </a>
    ))}
  </div>
</div>

<script>
  async function detectPlatform(): Promise<string> {
    const ua = navigator.userAgent.toLowerCase();
    const platform = (navigator.platform || '').toLowerCase();

    if (platform.includes('win') || ua.includes('windows')) return 'windows';
    if (platform.includes('linux') || ua.includes('linux')) return 'linux';

    if (platform.includes('mac') || ua.includes('mac')) {
      // 尝试用 userAgentData 区分 ARM / Intel
      try {
        const uaData = (navigator as any).userAgentData;
        if (uaData?.getHighEntropyValues) {
          const hints = await uaData.getHighEntropyValues(['architecture']);
          return hints.architecture === 'arm' ? 'mac-arm' : 'mac-intel';
        }
      } catch {}
      return 'mac-arm'; // 默认 Apple Silicon（现代 Mac 主流）
    }

    return 'mac-arm';
  }

  async function initDownloadButtons() {
    const platform = await detectPlatform();

    document.querySelectorAll<HTMLElement>('.download-button').forEach((container) => {
      const btn = container.querySelector<HTMLElement>('.download-main-btn');
      const dropdown = container.querySelector<HTMLElement>('.download-dropdown');
      const labelEl = container.querySelector<HTMLElement>('.download-label');

      if (!btn || !dropdown) return;

      // 更新按钮文本
      const detected = dropdown.querySelector<HTMLElement>(`[data-platform="${platform}"]`);
      if (labelEl && detected) {
        const labelText = detected.querySelector('div')?.textContent;
        if (labelText) labelEl.textContent = labelText;
      }

      // 下拉菜单切换
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = dropdown.style.display !== 'none';
        dropdown.style.display = isOpen ? 'none' : 'block';
        btn.setAttribute('aria-expanded', String(!isOpen));
      });

      // 悬停效果
      dropdown.querySelectorAll<HTMLElement>('.dropdown-item').forEach((item) => {
        item.addEventListener('mouseenter', () => {
          item.style.background = 'rgba(38,36,42,0.04)';
        });
        item.addEventListener('mouseleave', () => {
          item.style.background = '';
        });
      });
    });

    // 点击外部关闭
    document.addEventListener('click', () => {
      document.querySelectorAll<HTMLElement>('.download-dropdown').forEach((d) => {
        d.style.display = 'none';
      });
      document.querySelectorAll<HTMLElement>('.download-main-btn').forEach((b) => {
        b.setAttribute('aria-expanded', 'false');
      });
    });
  }

  // DOM 就绪后初始化
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDownloadButtons);
  } else {
    initDownloadButtons();
  }
</script>
